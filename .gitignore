# Python
__pycache__/
*.pyc
*.egg-info/

# Secrets in a local .env file — never commit (the FILE, not just a dir)
.env
.env.*
.env/

# Virtualenvs
.venv/
venv/
# Local virtualenv (if created in-tree as `arcticswarm/`)
arcticswarm/bin/
arcticswarm/lib/
arcticswarm/include/
arcticswarm/pyvenv.cfg

# Eval run outputs
results/
arcticswarm/results/

# Content / fetch caches — never commit cache DBs or run caches
cache/
fetch_cache/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Settings file — never commit real secrets; only the template is tracked
config_files.json

# Benchmark datasets are regenerated locally via scripts/fetch_datasets.sh
# (we ship loaders + CONV_ID specs under eval/data/subset_specs/, not the
# questions/answers themselves). Regenerate them; don't commit them.
/arcticswarm/eval/data/*.csv

# Test / lint / build / coverage artifacts
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/
.coverage
htmlcov/

# Editor / OS
.DS_Store
.vscode/
.idea/

# Local scratch
scratch/
*.scratch
